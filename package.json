{
  "name": "terradash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate && tsc -b && vite build",
    "generate": "node scripts/generate-map.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:branding": "node scripts/validate-branding.mjs",
    "validate:layout": "node scripts/validate-layout.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "vitest": "latest",
    "jsdom": "latest"
  }
}
